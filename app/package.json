{
  "name": "codsoft-ml-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-hosted frontend and inference API for the CodSoft machine learning tasks.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "check": "npm run typecheck && npm run test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.118.0"
  }
}
